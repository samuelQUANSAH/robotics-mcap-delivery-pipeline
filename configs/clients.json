      "chunk_size_mb": 128,
      "delivery_target": "gs://embodied-locomotion-vla-lake/raw_mcap/",
      "storage_class": "GCS_STANDARD",
      "field_mappings": {
        "/camera/wrist_rgb": "/sensors/front_stereo/image_rect_color",
        "/depth/aligned_depth": "/sensors/front_stereo/depth_registered",
        "/imu/wrist": "/sensors/pelvis_imu/data",
        "/robot/joint_states": "/whole_body_controller/joint_states"
      },
      "quality_gates": {
        "min_hand_in_frame_confidence": 0.45,
        "max_sensor_sync_drift_ms": 2.0,
        "min_episode_hz": 50.0,
        "drop_occluded_frames": false,
        "require_joint_finite": true
      },
      "custom_metadata": {
        "coordinate_frame": "ros_rep_103_flu",
        "hand_segmentation_model": "sam2-hand-v3-relaxed"
