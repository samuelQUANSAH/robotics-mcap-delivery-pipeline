{
  "clients": {
    "frontier_manipulation_lab": {
      "client_id": "frontier_manipulation_lab",
      "display_name": "Frontier Lab A — Dexterous Manipulation",
      "schema_version": "v2.4.0-dex",
      "container_format": "mcap",
      "compression": "zstd",
      "chunk_size_mb": 64,
      "delivery_target": "s3://frontier-dex-ingest-us-west-2/episodes/v2/",
      "storage_class": "S3_INTELLIGENT_TIERING",
      "field_mappings": {
        "/camera/wrist_rgb": "ego_hand_cam.rgb_frame",
        "/depth/aligned_depth": "ego_hand_cam.depth_mm",
        "/imu/wrist": "telemetry.imu_6dof",
        "/robot/joint_states": "kinematics.bimanual_joints_rad"
      },
      "quality_gates": {
        "min_hand_in_frame_confidence": 0.85,
        "max_sensor_sync_drift_ms": 5.0,
        "min_episode_hz": 30.0,
        "drop_occluded_frames": true,
        "require_joint_finite": true
      },
      "custom_metadata": {
        "coordinate_frame": "right_handed_z_up",
        "hand_segmentation_model": "sam2-hand-v3-strict"
      }
    },
    "embodied_navigation_lab": {
      "client_id": "embodied_navigation_lab",
